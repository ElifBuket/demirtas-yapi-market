# Bu dosyayı ".env" olarak kopyalayın. .env ASLA Git'e eklenmez (.gitignore).
APP_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_NAME=demirtas
DB_USER=demirtas_app
DB_PASS=
# Yalnızca SELECT yetkili yapay zekâ kullanıcısı (scripts/ai_readonly.sql)
AI_DB_USER=demirtas_ai
AI_DB_PASS=
# Yapay zekâ asistanı için (boşsa kural tabanlı yanıt kullanılır)
ANTHROPIC_API_KEY=
# Ters vekil (nginx/Cloudflare) arkasındaysanız 1
TRUST_PROXY=0
FIRMA_UNVAN=Demirtaş Yapı Market Ticaret A.Ş.
FIRMA_VKN=
FIRMA_VERGI_DAIRESI=
FIRMA_ADRES=
FIRMA_ILCE=
FIRMA_IL=
FIRMA_EPOSTA=
